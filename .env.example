# Gemini AI configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# MongoDB connection
# Add your actual connection string to the root .env file only.
MONGODB_URI="YOUR_MONGODB_CONNECTION_STRING"

# Session security
# Set a strong, randomly generated secret in the root .env file.
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Application environment
NODE_ENV="development"